<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>screenrecorder-cli</AssemblyName>
    <RootNamespace>ScreenRecorder.Cli</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenRecorder.Core\ScreenRecorder.Core.csproj" />
    <ProjectReference Include="..\ScreenRecorder.Capture\ScreenRecorder.Capture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScreenRecorder.Cli.Tests" />
    <InternalsVisibleTo Include="ScreenRecorder.Capture.Tests" />
  </ItemGroup>
</Project>
